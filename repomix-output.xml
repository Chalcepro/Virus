        char buffer[100];
        while (fgets(buffer, sizeof(buffer), fp))
            printf("Read: %s", buffer);
        fclose(fp);
    }
}

// Comparator for qsort
int comparator(const void *a, const void *b) {
    return *(int*)a - *(int*)b;
}



